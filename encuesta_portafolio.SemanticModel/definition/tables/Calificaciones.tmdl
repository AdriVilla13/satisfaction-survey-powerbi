table Calificaciones
	lineageTag: 330f57da-3238-41f5-a328-d8e518973087

	measure Clientes = DISTINCTCOUNT(Calificaciones[ID Respuesta])
		lineageTag: aa0c9b7d-b3de-4ca9-aef1-c33139af818e

	measure 'Calificaciones válidas' = COUNTX(Calificaciones, RELATED(Escala[Puntos]))
		formatString: 0
		lineageTag: a4eb0845-abfb-4c57-adad-5294289f75b0

	measure Índice = AVERAGEX(Calificaciones, RELATED(Escala[Puntos]))
		formatString: 0
		lineageTag: 28abb805-6939-466b-90a2-ea8622609270

		annotation PBI_FormatHint = {"isDecimal":true}

	measure '% Excelente' =
			DIVIDE(
			    CALCULATE([Calificaciones válidas], Escala[Respuesta] = "Excelente"),
			    [Calificaciones válidas]
			)
		formatString: 0%;-0%;0%
		lineageTag: 60cd882f-10e8-4cbe-81b4-6e8d2210e0ef

	measure '% Regular o Malo' =
			DIVIDE(
			    CALCULATE([Calificaciones válidas], Escala[Respuesta] IN {"Regular", "Malo"}),
			    [Calificaciones válidas]
			)
		formatString: 0%;-0%;0%
		lineageTag: 04224e24-dcca-456b-909b-66d0ddaf55a5

	measure 'Llegaron a pie' = CALCULATE(COUNTROWS(Calificaciones), Escala[Respuesta] = "Llegó a pie")
		formatString: 0
		lineageTag: 54e389a5-063a-4338-8025-58b576e2e418

	measure 'Total respuestas' = COUNTROWS(Calificaciones)
		formatString: 0
		lineageTag: 6ba4a51c-0a9b-4209-925c-9a93a5dee12f

	measure 'Detalle comentario' = SELECTEDVALUE(Respuestas[Mesero])
		lineageTag: 9355a247-2274-4d37-a381-6293e526967a

	measure Comentario = SELECTEDVALUE(Respuestas[Comentarios])
		lineageTag: 96bdd616-08b6-4243-a929-1df0ec10a20a

	column 'ID respuesta'
		dataType: int64
		formatString: 0
		lineageTag: 31999bfe-aded-466b-ae07-e585b0a7c328
		summarizeBy: none
		sourceColumn: ID respuesta

		annotation SummarizationSetBy = Automatic

	column Pregunta
		dataType: string
		lineageTag: 27ad3abe-d8da-4a88-b397-ba86266d996a
		summarizeBy: none
		sourceColumn: Pregunta

		annotation SummarizationSetBy = Automatic

	column Respuesta
		dataType: string
		lineageTag: 5e056f9e-cea3-412e-af9a-5df5926aec45
		summarizeBy: none
		sourceColumn: Respuesta

		annotation SummarizationSetBy = Automatic

